{
  "concurrency": 3,
  "max_rounds": 3,
  "max_lessons": 30,
  "merge_lessons": false,
  "base_branch": "main",
  "merge_method": "merge",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human",
    "in_progress": "factory:in-progress"
  },
  "routing": {
    "low":    { "code": "haiku" },
    "medium": { "code": "sonnet" },
    "high":   { "code": "sonnet" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "haiku" },
    "security": { "security": "opus" }
  },
  "reviewers_after_gate": ["ux", "ui"],
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/LESSONS.md"
  ],
  "ports": { "base": 5100, "step": 10 },
  "untrusted_input": ["intake", "retro"],
  "runtime": { "reviewers": "host" },
  "runners": {
    "gemini": { "cmd": ["gemini", "-m", "{model}", "--approval-mode=yolo", "--skip-trust", "-p", "{prompt}"],
                "models": { "haiku": "", "sonnet": "", "opus": "", "fable": "" } },
    "cursor": { "cmd": ["agent", "-p", "--force", "--trust", "--workspace", "{repo}", "--model", "{model}", "{prompt}"],
                "models": { "haiku": "", "sonnet": "", "opus": "", "fable": "" } },
    "grok":   { "cmd": ["grok", "--yolo", "--cwd", "{repo}", "-m", "{model}", "-p", "{prompt}"],
                "models": { "haiku": "", "sonnet": "", "opus": "", "fable": "" } }
  },
  "codex": {
    "models": { "haiku": "gpt-6-luna", "sonnet": "gpt-6.2-sol", "opus": "gpt-6.2-astra", "fable": "gpt-6.2-astra" },
    "sandbox": { "default": "workspace-write", "builder": "danger-full-access" }
  },
  "prices_usd_per_mtok": {
    "claude-fable-5-1":  { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "claude-opus-5-5":   { "input": 4.0,  "output": 20.0, "cache_write_5m": 5.0,  "cache_write_1h": 8.0,  "cache_read": 0.20 },
    "claude-sonnet-5-5": { "input": 2.0,  "output": 10.0, "cache_write_5m": 2.5,  "cache_write_1h": 4.0,  "cache_read": 0.20 },
    "claude-haiku-5-5":  { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
